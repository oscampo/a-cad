  "texts": {
   "t41": {
    "pt": "p40",
    "text": "%ort2iso(vista, k, ox, oy):\n  c:cos(π/6)\n  s:sin(π/6)\n  if vista==\"T\":\n    T:[c,c,0;-s,s,0;0,0,1]\n  elif vista==\"R\":\n    T:[c,0,0;s,1,0;0,0,1]\n  else:\n    T:[c,0,0;-s,1,0;0,0,1]\n  M:[T_(1,1),T_(1,2);T_(2,1),T_(2,2)]\n  Q:M*transpose(M)\n  th:0.5*atan2(2*Q_(1,2); Q_(1,1)-Q_(2,2))\n  m1:(Q_(1,1)+Q_(2,2))/2\n  m2:sqrt(((Q_(1,1)-Q_(2,2))/2)^2+Q_(1,2)^2)\n  s1:sqrt(m1+m2)\n  s2:sqrt(m1-m2)\n  dt:det(M)\n  if isa(k; \"group\"):\n    for i in 1..k.n:\n      ort2iso(vista, k_i, ox, oy)\n  elif isa(k; \"contour\"):\n    for i in 1..k.n:\n      ort2iso(vista, k_i, ox, oy)\n  elif isa(k; \"circle\"):\n    C:T*[k.c.x;k.c.y;1]\n    point(\"P\"+k.c; ox+C_1; oy+C_2)\n    point(\"A\"+k+\"a\"; ox+C_1+k.r*s1*cos(th); oy+C_2+k.r*s1*sin(th))\n    point(\"A\"+k+\"b\"; ox+C_1-k.r*s2*sin(th); oy+C_2+k.r*s2*cos(th))\n    ellipse(\"P\"+k.c; \"A\"+k+\"a\"; \"A\"+k+\"b\")\n  elif isa(k; \"line\"):\n    A:T*[k.a.x;k.a.y;1]\n    B:T*[k.b.x;k.b.y;1]\n    point(\"P\"+k.a; ox+A_1; oy+A_2)\n    point(\"P\"+k.b; ox+B_1; oy+B_2)\n    line(\"P\"+k.a; \"P\"+k.b)\n  elif isa(k; \"arc\"):\n    r:hypot(k.a.x-k.c.x; k.a.y-k.c.y)\n    C:T*[k.c.x;k.c.y;1]\n    A:T*[k.a.x;k.a.y;1]\n    B:T*[k.b.x;k.b.y;1]\n    point(\"P\"+k.c; ox+C_1; oy+C_2)\n    point(\"P\"+k.a; ox+A_1; oy+A_2)\n    point(\"P\"+k.b; ox+B_1; oy+B_2)\n    point(\"A\"+k+\"a\"; ox+C_1+r*s1*cos(th); oy+C_2+r*s1*sin(th))\n    point(\"A\"+k+\"b\"; ox+C_1-r*s2*sin(th); oy+C_2+r*s2*cos(th))\n    if dt<0:\n      earc(\"P\"+k.c; \"A\"+k+\"a\"; \"A\"+k+\"b\"; \"P\"+k.b; \"P\"+k.a)\n    else:\n      earc(\"P\"+k.c; \"A\"+k+\"a\"; \"A\"+k+\"b\"; \"P\"+k.a; \"P\"+k.b)\n  k",
    "h": 8,
    "ang": 0,
    "anchor": "tl",
    "color": "auto",
    "readable": true
   },
